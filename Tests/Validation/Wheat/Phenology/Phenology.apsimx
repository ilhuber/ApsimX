                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using System;",
                        "using Models.Core;",
                        "using Models.Interfaces;",
                        "using Models.PMF;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] IClock Clock;",
                        "        [Link] ISummary Summary;",
                        "        [Link] Fertiliser Fertiliser;",
                        "",
                        "        public void Apply(double N, double P, double K, double S, double CA, double ZN, double MG, double MN, double CU)",
                        "        {",
                        "            if (N > 0)",
                        "                Fertiliser.Apply(N, \"NO3N\", 0, -1, true);",
                        "        }",
                        "    }",
                        "}",
                        ""
                      ],
                      "Parameters": [],
                      "Name": "ApplyFertiliser",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using APSIM.Shared.Utilities;",
                        "using Models.Utilities;",
                        "using Models.Soils;",
                        "using Models.PMF;",
                        "using Models.Core;",
                        "using Models.PMF.Phen;",
                        "using System;",
                        "using System.Linq;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable] ",
                        "    public class Script : Model",
                        "    {    ",
                        "        [Description(\"Days between Sowing and Emergence. 0 to not override\")] ",
                        "        public int EmergenceDelay {get; set;}",
                        "    ",
                        "        [Link] Summary Summary;\t",
                        "        [Link] Plant Wheat;",
                        "    ",
                        "        public int days {get; set;}",
                        "        ",
                        "        public DateTime SowDate {get; set;}",
                        "        public DateTime FlagDate {get; set;}",
                        "        public DateTime FloweringDate {get; set;}",
                        "        public DateTime HarvestDate {get; set;}",
                        "        ",
                        "        public double SowDays {get; set;}",
                        "        public double FlagDays {get; set;}",
                        "        public double FloweringDays {get; set;}",
                        "        public double HarvestDays {get; set;}",
                        "        ",
                        "        private bool start = false;",
                        "        [Link] private Clock Clock;",
                        "        ",
                        "        [EventSubscribe(\"Sowing\")]",
                        "        private void OnSowing(object sender, EventArgs e)",
                        "        {",
                        "            start = true;",
                        "            days = 0;",
                        "            SowDate = Clock.Today;",
                        "            SowDays = Clock.Today.DayOfYear-1;",
                        "        }",
                        "        ",
                        "        [EventSubscribe(\"PhaseChanged\")]",
                        "        private void OnPhaseChanged(object sender, PhaseChangedType change)",
                        "        {",
                        "            if (change.StageName == \"Germination\" && EmergenceDelay > 0) ",
                        "\t\t    {",
                        "\t\t    \tstring emergenceDate = (SowDate.AddDays(EmergenceDelay)).ToString(\"dd-MMM\");",
                        "                Wheat.Phenology.SetEmergenceDate(emergenceDate);",
                        "\t\t    }",
                        "\t\t    if (change.StageName == \"FlagLeafAppearance\") ",
                        "\t\t    {",
                        "\t\t    \tFlagDate = Clock.Today;",
                        "\t\t    \tFlagDays = (FlagDate - SowDate).TotalDays + 1;",
                        "\t\t    }",
                        "\t\t    if (change.StageName == \"Anthesis\") ",
                        "\t\t    {",
                        "\t\t    \tFloweringDate = Clock.Today;",
                        "\t\t    \tFloweringDays = (FloweringDate - SowDate).TotalDays + 1;",
                        "\t\t    }",
                        "        }",
                        "        ",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            if (start)",
                        "            {",
                        "                days += 1;",
                        "            }",
                        "            if (Wheat.IsReadyForHarvesting)",
                        "            {",
                        "                HarvestDate = Clock.Today;",
                        "\t\t    \tHarvestDays = (HarvestDate - SowDate).TotalDays + 1;",
                        "                Wheat.Harvest();",
                        "                Wheat.EndCrop();",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "EmergenceDelay",
                          "Value": "0"
                        }
                      ],
                      "Name": "PhenologyTimes",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
