                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Newtonsoft.Json;",
                        "using System.Data;",
                        "using System.Xml.Serialization;",
                        "using Models;",
                        "using System.Text;",
                        "using System.Collections.Generic;",
                        "using Models.Interfaces;",
                        "using System.Globalization;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "using Models.Soils;",
                        "using Models.Utilities;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] Clock Clock;",
                        "        [Link] Fertiliser Fertiliser;",
                        "        [Link] Summary Summary;",
                        "        [Link] Soil Soil;",
                        "        [Link] Plant Wheat;",
                        "        [Link] Simulation Simulation;",
                        "        Accumulator accumulatedRain;",
                        "        ",
                        "        [Description(\"Sowing date (d-mmm)\")]",
                        "        public string SowDate { get; set; }",
                        "        [Description(\"Treatment Name\")]",
                        "        public string Treat { get; set; }",
                        "        [Display(Type = DisplayType.CultivarName)]",
                        "        [Description(\"Cultivar to be sown\")]",
                        "        public string CultivarName { get; set; }",
                        "        [Description(\"Sowing depth (mm)\")]",
                        "        public double SowingDepth { get; set; }",
                        "        [Description(\"Row spacing (mm)\")]",
                        "        public double RowSpacing { get; set; }",
                        "        [Description(\"Plant population (/m2)\")]",
                        "        public double Population { get; set; }",
                        "",
                        "        [Description(\"Emergence Date File Path\")]",
                        "        public string FilePath {get; set;}",
                        "",
                        "        private DateTime EmergenceDate {get; set;}",
                        "        private string EmergenceString {get; set;}",
                        "",
                        "        [JsonIgnore] private DataTable EmergDates{ get; set; }",
                        "",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnStartOfSimulation(object sender, EventArgs e)",
                        "        {",
                        "            ",
                        "            string fullFileName = PathUtilities.GetAbsolutePath(FilePath, Simulation.FileName);",
                        "            ",
                        "            ApsimTextFile textFile = new ApsimTextFile();",
                        "            textFile.Open(fullFileName);",
                        "            EmergDates = textFile.ToTable();",
                        "            textFile.Close();",
                        "        }",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "",
                        "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                        "            {",
                        "                ",
                        "                foreach (DataRow row in EmergDates.Rows)",
                        "                {",
                        "                    string Env = Convert.ToString(row[\"TOS\"]);",
                        "                    if (Env == Treat)",
                        "                    {",
                        "                        EmergenceDate = Convert.ToDateTime(row[CultivarName]);",
                        "                        EmergenceString = EmergenceDate.ToString(\"dd-MMM\", CultureInfo.InvariantCulture);",
                        "                    }",
                        "                }",
                        "",
                        "                Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                        "                Wheat.Phenology.SetEmergenceDate(EmergenceString);",
                        "            }",
                        "        ",
                        "        }",
                        "        ",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "SowDate",
                          "Value": ""
                        },
                        {
                          "Key": "Treat",
                          "Value": ""
                        },
                        {
                          "Key": "CultivarName",
                          "Value": ""
                        },
                        {
                          "Key": "SowingDepth",
                          "Value": "50"
                        },
                        {
                          "Key": "RowSpacing",
                          "Value": "250"
                        },
                        {
                          "Key": "Population",
                          "Value": "150"
                        },
                        {
                          "Key": "FilePath",
                          "Value": "%root%\\Tests\\Validation\\Wheat\\inputs\\WaggaWaggaEmergenceDates.csv"
                        }
                      ],
                      "Name": "Sowing",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.Soils;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] Clock Clock;",
                        "        [Link] Fertiliser Fertiliser;",
                        "        [Link] Summary Summary;",
                        "        ",
                        "        ",
                        "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                        "        public double Amount { get; set;}",
                        "        ",
                        "        [Description(\"Crop to be fertilised\")]",
                        "        public string CropName { get; set;}",
                        "        ",
                        "        ",
                        "        ",
                        "",
                        "        [EventSubscribe(\"Sowing\")]",
                        "        private void OnSowing(object sender, EventArgs e)",
                        "        {",
                        "            Model crop = sender as Model;",
                        "            if (crop.Name.ToLower()==CropName.ToLower())",
                        "                Fertiliser.Apply(amount: Amount, type: \"NO3N\");",
                        "        }",
                        "        ",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "Amount",
                          "Value": "200"
                        },
                        {
                          "Key": "CropName",
                          "Value": "wheat"
                        }
                      ],
                      "Name": "SowingFertiliser",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
