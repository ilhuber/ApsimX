                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] IClock Clock;",
                        "        [Link] IPlant Plant;",
                        "        [Link] ISummary Summary;",
                        "        ",
                        "        ",
                        "        public string Cultivar {get; set;}",
                        "",
                        "\t\tpublic void Sow(string cultivar, double population, double depth, double rowSpacing)",
                        "\t\t{",
                        "\t\t    Cultivar = cultivar;",
                        "\t\t    Plant.Sow(Cultivar, population, depth, rowSpacing);",
                        "\t\t}",
                        "    }",
                        "}",
                        ""
                      ],
